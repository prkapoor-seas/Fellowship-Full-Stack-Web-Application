# Copy this file to .env and fill in real values. .env is gitignored.
#
#   cp .env.example .env
#
# Generate APP_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"

APP_SECRET_KEY=

# Gmail address used to send notification / signup / password-reset email,
# and a Google "app password" for it (not the account password).
SMTP_EMAIL=
SMTP_PASSWORD=
